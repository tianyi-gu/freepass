# Copy this file to .env and fill in your values
# Get these from your Supabase project: Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Gemini API key for Casey chatbot
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here

# Groq API key for Casey speech-to-text (Whisper)
EXPO_PUBLIC_GROQ_KEY=your-groq-api-key-here

# OpenAI API key for Casey text-to-speech (gpt-4o-mini-tts)
EXPO_PUBLIC_OPENAI_API_KEY=your-openai-api-key-here
