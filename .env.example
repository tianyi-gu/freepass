# Copy to .env. These two PUBLIC settings are the only credentials in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional, local live-model evaluation only. Never prefix a provider key EXPO_PUBLIC_.
# Production Casey uses OPENAI_API_KEY stored as a Supabase Edge Function secret.
FREEPASS_OPENAI_API_KEY=your-openai-api-key-here
